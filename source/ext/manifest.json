{
  "manifest_version": 3,
  "name": "LeadChat → Заявка в CRM",
  "version": "2.8.48",
  "minimum_chrome_version": "120",
  "description": "Собирает заявку из открытого диалога LeadChat (телефон, адрес по карте, время, суть, озвученные цены) и создаёт её в CRM лид-центра вашей рабочей сессией.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://188-225-34-82.sslip.io/*",
    "https://chat.partner-lead-centre.ru/*",
    "https://72-56-68-159.sslip.io/*",
    "https://bt-lead-centre.ru/*",
    "https://kp-lead-centre.ru/*",
    "https://mnc-lead-centre.ru/*",
    "https://llm.api.cloud.yandex.net/*",
    "https://nominatim.openstreetmap.org/*",
    "https://functions.yandexcloud.net/*",
    "https://72-56-99-103.sslip.io/*",
    "https://suggestions.dadata.ru/*",
    "https://geocode-maps.yandex.ru/*",
    "https://suggest-maps.yandex.ru/*",
    "https://www.avito.ru/*",
    "https://m.avito.ru/*",
    "https://clck.ru/*",
    "https://yandex.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://188-225-34-82.sslip.io/*",
        "https://chat.partner-lead-centre.ru/*",
        "https://72-56-68-159.sslip.io/*"
      ],
      "js": [
        "rt-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://188-225-34-82.sslip.io/*",
        "https://chat.partner-lead-centre.ru/*",
        "https://72-56-68-159.sslip.io/*"
      ],
      "js": [
        "rt.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://188-225-34-82.sslip.io/*",
        "https://chat.partner-lead-centre.ru/*",
        "https://72-56-68-159.sslip.io/*"
      ],
      "js": [
        "cityslugs.js",
        "addrrules.js",
        "extract.js",
        "worktype.js",
        "links.js",
        "tg.js",
        "request-notes.js",
        "territory.js",
        "repeat.js",
        "actions.js",
        "actions-ui.js",
        "watch-act.js",
        "actions-cust.js",
        "intake.js",
        "personal-queue.js",
        "personal.js",
        "assistant-native.js",
        "native-api.js",
        "native-office.js",
        "workflow.js",
        "assistant-runner.js",
        "observer.js",
        "stable-dom.js",
        "assistant-ui.js",
        "city-reply.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "LeadChat → Заявка: настройки и состояние"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
